// Phase 1: identity, organization, and multi-tenancy foundation.
//
// Users are platform identities (globally unique email) — Organizations
// grant permissions through Membership, not through a direct FK on User.
// This is deliberate: it lets a user hold memberships in more than one
// organization without a schema migration, even though Phase 1's
// application logic only ever creates one membership per user. See
// docs/ARCHITECTURE.md §4 for the tenant-scoping strategy this schema is
// designed around.
//
// Phase 2: the logistics domain — Ship, TruckRequirement,
// DocumentRequirement, Driver. All four are organization-scoped (directly
// or, for the two Requirement models, transitively through Ship) and go
// through the same tenant-scoping Prisma extension as Membership/Invitation
// — see core/prisma.ts's TENANT_SCOPED_MODELS.
//
// Driver.currentShipId is a deliberately simple nullable pointer, not a
// full assignment entity — Phase 2 explicitly excludes the
// invite/confirm/reject/cancel assignment workflow (that's Phase 3). This
// field only answers "which ship is this driver currently on," which the
// Drivers list needs to render honestly; it carries no state machine of
// its own.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  memberships       Membership[]
  invitations       Invitation[]
  ships             Ship[]
  drivers           Driver[]
  assignments       Assignment[]
  yellowZoneItems   YellowZoneItem[]
  notifications     Notification[]
  reminderCampaigns ReminderCampaign[]

  @@map("organizations")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastLoginAt  DateTime?

  memberships               Membership[]
  refreshTokens             RefreshToken[]
  sentInvitations           Invitation[]        @relation("InvitationInvitedBy")
  createdAssignments        Assignment[]        @relation("AssignmentCreatedBy")
  recordedAttempts          AssignmentAttempt[] @relation("AssignmentAttemptRecordedBy")
  claimedYellowZoneItems    YellowZoneItem[]    @relation("YellowZoneItemAssignedTo")
  notifications             Notification[]
  preferences               UserPreferences?
  createdReminderCampaigns  ReminderCampaign[]  @relation("ReminderCampaignCreatedBy")
  approvedReminderCampaigns ReminderCampaign[]  @relation("ReminderCampaignApprovedBy")

  @@map("users")
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           Role
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

// Each row is one logged-in device/browser session — deliberately not
// modeled as a separate "Session" entity, since it would just duplicate
// these same fields. userAgent/ip/createdAt/revokedAt already carry what
// an "active sessions" list or "log out this device" feature needs later;
// no schema change required to add that UI on top of this table.
model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  familyId          String
  userAgent         String?
  ip                String?
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?   @unique
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  role           Role
  tokenHash      String           @unique
  invitedById    String
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  acceptedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation("InvitationInvitedBy", fields: [invitedById], references: [id])

  @@index([organizationId])
  @@map("invitations")
}

// Fields match the actual Kinvo UI export (Kinvo.dc.html) — company, berth,
// gate, cargoType are real fields on the "Add Ship" form and ship cards,
// not part of the originally-sketched abstract schema in
// docs/ARCHITECTURE.md §3, which predates a close read of the design
// export.
//
// No rate/rateCurrency here — a ship does not have one price. Real port
// trucking is priced per destination and truck type (see TruckRequirement
// below); a ship-level rate was tried in an earlier Phase 2 refinement
// pass and corrected out per explicit product-owner direction — see
// docs/ARCHITECTURE.md's Decisions log.
model Ship {
  id             String     @id @default(cuid())
  organizationId String
  shipName       String
  company        String?
  eta            DateTime?
  reportingTime  DateTime?
  berth          String?
  gate           String?
  cargoType      String?
  status         ShipStatus @default(DRAFT)
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  truckRequirements    TruckRequirement[]
  documentRequirements DocumentRequirement[]
  currentDrivers       Driver[]              @relation("DriverCurrentShip")
  reminderCampaigns    ReminderCampaign[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("ships")
}

// One row per (destination, truck type) combination a ship needs — matches
// the actual mockup's "Destinations — different trucks can go to different
// places" UI, extended with a truckType field per the product owner's
// explicit choice to support both dimensions rather than picking one of the
// two reference sources over the other.
//
// rate/rateCurrency live HERE, not on Ship: real port trucking prices per
// destination and truck type, not per voyage — "Ever Given / Flatbed to
// Salalah / 35,000 PKR" and "Ever Given / Container to Muscat / 62,000 PKR"
// are two different prices on the same ship. An earlier refinement pass
// added a ship-level base rate with per-row overrides; that was corrected
// out per explicit product-owner direction (the base-rate concept doesn't
// reflect how these prices actually work) — see the Decisions log. rate is
// nullable because a requirement can exist before its price is negotiated
// (no fallback value now that there's no ship-level rate to fall back to);
// the UI shows "Rate not set" rather than inventing a number.
model TruckRequirement {
  id             String   @id @default(cuid())
  shipId         String
  destination    String
  truckType      String
  quantityNeeded Int
  rate           Decimal? @db.Decimal(10, 2)
  rateCurrency   String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ship        Ship         @relation(fields: [shipId], references: [id], onDelete: Cascade)
  assignments Assignment[]

  @@index([shipId])
  @@map("truck_requirements")
}

// documentType is a free-text field, not an enum — CNIC/License/Vehicle
// Registration/Port Entry Pass are example values a dispatcher enters, not
// a fixed, hardcoded list. No screen for this exists in the original
// Kinvo.dc.html export; this is new UI built for Phase 2, per the product
// owner's explicit choice, not a wiring of a pre-existing mock.
model DocumentRequirement {
  id           String   @id @default(cuid())
  shipId       String
  documentType String
  isRequired   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ship Ship @relation(fields: [shipId], references: [id], onDelete: Cascade)

  @@index([shipId])
  @@map("document_requirements")
}

// Fields match the actual driver records and detail-drawer in
// Kinvo.dc.html (name, phone, truck plate/type, license, nationalId,
// rating, previousJobs, languages, preferredRoutes, preferredCompanies) —
// richer than the abstract Driver sketch in docs/ARCHITECTURE.md §3.
// Driver.phone stays organization-scoped per the driver-pool-scope
// decision in the Decisions log (drivers are not platform identities).
model Driver {
  id                 String             @id @default(cuid())
  organizationId     String
  fullName           String
  phone              String
  licenseNumber      String?
  nationalId         String?
  truckPlate         String?
  truckType          String?
  capacity           String?
  languages          String?
  preferredRoutes    String?
  preferredCompanies String?
  rating             Decimal?           @db.Decimal(2, 1)
  previousJobsCount  Int                @default(0)
  availability       DriverAvailability @default(IDLE)
  currentShipId      String?
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currentShip  Ship?        @relation("DriverCurrentShip", fields: [currentShipId], references: [id], onDelete: SetNull)
  assignments  Assignment[]

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@index([organizationId, availability])
  @@index([currentShipId])
  @@map("drivers")
}

// Phase 3: one row per (driver, truck requirement) engagement — the fact
// that was missing from Phase 2. Scoped to TruckRequirement, not Ship, for
// the same reason rate lives there: different destinations/truck types on
// one ship are independent commercial engagements, and an assignment is
// fundamentally about one of those, not "the ship" in general.
//
// organizationId is denormalized directly onto this model (added after
// Phase 3 shipped, once the flat cross-ship "call list" view's default
// query — status=PENDING, no truckRequirementId/driverId — turned out to
// have no way to reach an org's own rows without walking
// truckRequirement -> ship for every row in the system. Immutable once
// set: an Assignment's parent TruckRequirement/Ship never moves to a
// different organization after creation, so there is nothing for this
// column to drift from. Tenant-scoped via the Prisma extension exactly
// like Ship/Driver (see core/prisma.ts's TENANT_SCOPED_MODELS) — set
// explicitly in assignments.service.ts's createAssignment for the same
// reason every other tenant-scoped create() does (the extension injects
// it at runtime, but Prisma's generated create types can't see that).
//
// onDelete: Restrict on the truckRequirement/driver FKs (not Cascade) — a
// Driver or TruckRequirement with live assignment history must never be
// silently deletable out from under that history; the service layer
// requires cancelling active assignments first and surfaces a clear error
// instead of a raw FK-violation 500. onDelete: Cascade on the new
// organization FK matches Ship/Driver's own relation to Organization —
// there is no organization-delete flow today, so this is dormant, but
// keeping it consistent with the rest of the schema avoids a one-off shape
// if that ever changes.
//
// agreedRate is nullable and deliberately has NO paired agreedCurrency
// column: currency belongs to the commercial contract (the
// TruckRequirement itself), never to an individual driver's negotiation
// within it — every driver recruited against the same requirement is
// quoted in the same currency, only the amount can differ. Null means
// "use the requirement's posted rate," matching the exact
// override-with-no-silent-fallback pattern TruckRequirement.rate already
// established relative to the (now-removed) ship-level rate.
model Assignment {
  id                 String           @id @default(cuid())
  organizationId     String
  truckRequirementId String
  driverId           String
  status             AssignmentStatus @default(PENDING)
  agreedRate         Decimal?         @db.Decimal(10, 2)
  invitedAt          DateTime         @default(now())
  respondedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  rejectionReason    String?
  noShowAt           DateTime?
  completedAt        DateTime?
  createdByUserId    String
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  truckRequirement    TruckRequirement     @relation(fields: [truckRequirementId], references: [id], onDelete: Restrict)
  driver              Driver               @relation(fields: [driverId], references: [id], onDelete: Restrict)
  // No onDelete specified, matching Invitation.invitedById's exact shape —
  // there is no user-delete flow today, so this is dormant either way, but
  // an assignment's record of who created it is a fact worth restricting
  // against silent loss, same reasoning as every other "who did this" FK
  // in this schema.
  createdByUser       User                 @relation("AssignmentCreatedBy", fields: [createdByUserId], references: [id])
  attempts            AssignmentAttempt[]
  voiceCallPlacements VoiceCallPlacement[]

  // A driver may have at most one ACTIVE (PENDING or CONFIRMED) engagement
  // per requirement at a time — re-approaching a driver after an earlier
  // rejection is a real workflow, so this must be a PARTIAL unique index,
  // not a full one. Prisma's schema DSL cannot express a partial index;
  // the actual constraint is hand-added in the migration SQL (see
  // migration comment). This @@index is the query-shape hint only — the
  // real uniqueness guarantee lives in the migration, not here.
  @@index([truckRequirementId, driverId])
  @@index([truckRequirementId, status])
  @@index([driverId, status])
  // The flat "call list" view's default query (status=PENDING, no other
  // filter) — this is what a plain @@index([status]) alone can't serve:
  // without organizationId, Postgres has no way to jump straight to one
  // org's pending rows, only to filter every org's pending rows one by one
  // via a join back through truckRequirement -> ship. This composite index
  // is the one that actually matches that access pattern.
  @@index([organizationId, status])
  @@map("assignments")
}

// Append-only contact history against one Assignment — deliberately a
// separate table rather than counters-on-Assignment, because Phase 4's
// CALL-E retry logic needs full history (multiple attempts over time),
// not just a count. This table is also, not incidentally, the exact
// ledger CALL-E's outbound-call worker will write into instead of a
// dispatcher clicking a button — see docs/ARCHITECTURE.md's Phase 3
// Decisions log for the full CALL-E-readiness reasoning.
//
// externalCallId is nullable and unpopulated until Phase 4 — reserved now
// so a provider's call-SID gives webhook-replay idempotency for free the
// day it's needed, with no migration required at that point.
model AssignmentAttempt {
  id               String         @id @default(cuid())
  assignmentId     String
  outcome          AttemptOutcome
  notes            String?
  externalCallId   String?        @unique
  // Which voice provider produced this attempt, when it wasn't a human
  // dispatcher — null for every human-recorded attempt (recordedByUserId
  // set instead). A plain string, not an enum: CALL-E is the only
  // provider today (see core/voice/VoiceProvider.ts), and a string avoids
  // a schema migration the day a second provider is added, at the cost of
  // no DB-level validation of the value — acceptable since this column is
  // written by exactly one call site (the voice worker), never from user
  // input.
  provider         String?
  recordedByUserId String?
  attemptedAt      DateTime       @default(now())

  assignment     Assignment          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  // SetNull, not Restrict — recordedByUserId is already nullable for the
  // Phase 4 case of a CALL-E webhook attempt with no human actor at all,
  // so "we no longer know who recorded this" is an existing, valid state
  // this field can be in, not a new one this relation introduces.
  recordedByUser User?               @relation("AssignmentAttemptRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  webhookEvents  VoiceWebhookEvent[]
  yellowZoneItem YellowZoneItem?

  @@index([assignmentId, attemptedAt])
  @@map("assignment_attempts")
}

// Durable idempotency ledger for inbound voice-provider webhook events —
// keyed by the PROVIDER's own event id, not a generated one, so the insert
// itself IS the "have we already processed this exact delivery" check via
// the primary key's own uniqueness.
//
// Deliberately NOT written atomically with the AssignmentAttempt it
// corresponds to: confirmAssignment/rejectAssignment/logAttempt each run
// their own internal transaction and don't accept an externally-supplied
// one (a larger, riskier change to already-hardened Phase 3 code than this
// table's own guarantee requires). This row is instead the LAST of four
// independent, defense-in-depth idempotency layers voice.service.ts's
// processWebhookSignal relies on — see that file's module comment for all
// four. A crash between "attempt recorded" and "this row inserted" just
// means a retried delivery re-derives the same, already-correct outcome
// and finds AssignmentAttempt.externalCallId already set, rather than
// double-applying anything.
//
// Deliberately outside the tenant-scoping extension (see core/prisma.ts's
// TENANT_SCOPED_MODELS comment): a webhook arrives with no bound tenant
// context at all — the organization is only knowable after resolving
// attemptId back through Assignment, which is exactly why this table
// doesn't try to carry its own organizationId column redundantly.
model VoiceWebhookEvent {
  id         String   @id
  attemptId  String
  receivedAt DateTime @default(now())

  attempt AssignmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@map("voice_webhook_events")
}

// The durable record that a call is (or was) in flight for an assignment —
// created the moment CallEAdapter.requestConfirmationCall succeeds, before
// anything about the call's eventual outcome is known. Without this row,
// nothing on Kinvo's side could answer "which calls are we still waiting
// on?" — CALL-E's webhook is the only other source of that fact, and it
// can be lost (delivery failure) or never fire at all (no webhook exists
// for the `canceled` CallStatus — verified from the SDK's schema, not
// assumed). `resolvedAt` is what reconcileStaleAttempts (voice.service.ts)
// queries to find placements that missed their webhook and need an active
// re-check, and — past VOICE_RECONCILE_STALE_AFTER_MINUTES — placements
// Kinvo gives up waiting on and force-resolves to its own system_error.
//
// Deliberately not tenant-scoped (see AssignmentAttempt's own precedent):
// every access to it goes through an already-known assignmentId or
// externalCallId, never a "list all placements" query that would need
// organizationId to be safe.
model VoiceCallPlacement {
  id             String    @id @default(cuid())
  assignmentId   String
  provider       String
  externalCallId String    @unique
  placedAt       DateTime  @default(now())
  resolvedAt     DateTime?

  // Cascade, matching AssignmentAttempt's own relation to Assignment —
  // there is no delete flow for Assignment today (rows persist as
  // permanent history), so this is dormant in practice, but a placement
  // record has no meaning once its assignment is gone, same reasoning as
  // AssignmentAttempt's.
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([resolvedAt, placedAt])
  @@map("voice_call_placements")
}

// The persisted half of AuditLogger (apps/api/src/core/audit/audit-logger.ts)
// — every event already flowing through that interface (see AuditEventType
// in audit-events.ts) now also lands here, durable and queryable, instead of
// only as a structured pino log line. See docs/ARCHITECTURE.md §12 for the
// original design and this table's departure from it.
//
// Deliberately has NO foreign keys to User or Organization, unlike every
// other actor/tenant reference in this schema. An audit trail exists
// precisely to answer "who did what" *after the fact*, including after the
// actor's membership was removed, their account was disabled, or (in a
// future org-deletion feature) the organization itself no longer exists —
// an FK with onDelete: Cascade would silently erase the very audit trail
// that ought to survive the deletion it's describing, and onDelete: SetNull
// or Restrict are both wrong in different ways (SetNull loses "who," Restrict
// would block a legitimate member removal because of their own audit
// history). actorUserId/organizationId/targetId are therefore plain,
// unenforced string columns — the same trade-off already accepted
// deliberately for AssignmentAttempt.externalCallId's forward-compatibility
// slot, applied here for a durability reason instead.
model AuditLogEntry {
  id             String   @id @default(cuid())
  type           String
  actorUserId    String
  // Nullable for the same reason AuditEvent.organizationId is optional
  // (audit-events.ts): a few events (logout-all) aren't inherently
  // org-scoped, and fabricating one would be worse than omitting it.
  organizationId String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  // Every list/detail query this table serves is "this organization's
  // history, newest first" or "this organization's history for one entity" —
  // organizationId is always the first predicate, so it leads both indexes.
  @@index([organizationId, createdAt])
  @@index([organizationId, targetId])
  @@map("audit_log_entries")
}

// Phase 5: the human-review queue for an outbound confirmation call CALL-E
// could not resolve — SYSTEM_ERROR outcomes only (a malformed/unrecognized
// provider response, a genuine CALL-E-side failure, or Kinvo's own
// reconciliation timeout; see core/voice/outcomeTranslation.ts). This is
// deliberately NOT built against a literal inbound-call concept: the
// installed @call-e/calle SDK (v0.6.0, verified from its generated OpenAPI
// schema, not assumed) exposes no inbound-call primitive at all —
// `WebhookEventType` is a closed `"call.completed" | "call.failed" |
// "call.result_validation_failed"` enum, and `CalleCalls` has no method to
// provision a number or receive one. "An automated call CALL-E can't
// resolve" is answered here by an unresolved OUTBOUND call, not a fictional
// inbound one — see docs/ARCHITECTURE.md's Phase 5 Decisions log for the
// full reasoning and the product-owner decision (Option A) that resolved
// this.
//
// One row per AssignmentAttempt that reached SYSTEM_ERROR — created inside
// the SAME transaction as that attempt (see voice.service.ts), never as a
// separate follow-up write, so a crash between the two is not a state this
// table can end up in. assignmentAttemptId's unique constraint is what
// makes a duplicate webhook/reconciliation delivery a safe no-op: the
// AssignmentAttempt itself is only ever created once per terminal event
// (Phase 4's existing idempotency), so a YellowZoneItem 1:1 against it
// inherits that same guarantee for free, with no separate dedup mechanism
// needed.
//
// Deliberately tenant-scoped via the Prisma extension (added to
// core/prisma.ts's TENANT_SCOPED_MODELS) — unlike AssignmentAttempt/
// VoiceCallPlacement, which opted out because every access to them walks
// through an already-owned Assignment first. A dispatcher's Yellow Zone
// queue is the opposite access shape: a direct top-level list/filter
// query, the same as Ship/Driver, not a sub-resource reached through a
// parent. driverId/shipId are plain denormalized strings, not enforced
// FKs — same reasoning as AssignmentAttempt.provider and
// AuditLogEntry.actorUserId: written by exactly one call site (the voice
// module's escalation helper, from already-validated data), never from
// user input, so DB-level referential enforcement adds no real safety here.
//
// CORRECTION (Phase 5 hardening pass): an earlier version of this comment
// justified driverId/shipId as letting the queue "render without joining
// back through Assignment" — that was never actually true.
// yellow-zone.service.ts's toYellowZoneItemDto still joins through
// assignmentAttempt -> assignment -> driver/truckRequirement/ship for
// every list/get call (driverName/shipName/destination/truckType all come
// from that join, not from these columns), and neither column is used for
// filtering (yellowZoneListQuerySchema has no driverId/shipId filter).
// Their only actual value today is as a fallback identity pointer if
// Assignment/Driver/Ship rows were ever deleted out from under a
// historical Yellow Zone item — currently theoretical, since nothing in
// this schema deletes any of the three (Assignment has no delete flow at
// all; Driver/Ship deletion, if it existed, would hit onDelete: Restrict
// via Assignment first). Kept because they're cheap and harmless, not
// because they save a join.
model YellowZoneItem {
  id                  String             @id @default(cuid())
  organizationId      String
  assignmentAttemptId String             @unique
  driverId            String
  shipId              String
  reason              String
  priority            YellowZonePriority
  status              YellowZoneStatus   @default(PENDING)
  assignedToUserId    String?
  resolutionNotes     String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  resolvedAt          DateTime?

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignmentAttempt AssignmentAttempt @relation(fields: [assignmentAttemptId], references: [id], onDelete: Cascade)
  // SetNull, matching AssignmentAttempt.recordedByUserId's exact precedent —
  // "we no longer know who claimed this" is an acceptable state if a user
  // is ever removed, not a reason to block the removal or delete the item.
  assignedToUser    User?             @relation("YellowZoneItemAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)

  // Every list query this table serves is "this org's queue, filtered by
  // status" (the default view) or "...by priority" — same reasoning as
  // Assignment's own (organizationId, status) composite index.
  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@map("yellow_zone_items")
}

enum YellowZoneStatus {
  PENDING
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum YellowZonePriority {
  LOW
  MEDIUM
  HIGH
}

// Phase 6: the in-app notification inbox — see docs/ARCHITECTURE.md's
// Phase 6 Decisions log for the full reasoning behind what's built here
// (notifications only; ReminderCampaign/approval-gate/campaign-queue are
// explicitly out of scope for this pass) and why yellow_zone.escalated is
// currently the only notification-generating event (deliberate — audit
// events answer "what happened," notifications answer "what does this
// specific user need to know," and claim/unclaim/resolve/dismiss are
// already visible live in the Yellow Zone queue itself).
//
// User-specific, not organization-wide: matches the exact shape this
// document's own pre-Phase-5 sketch specified (`Notification { orgId,
// userId, type, payload, readAt }`, `User 1-N Notification`). Deliberately
// tenant-scoped via the Prisma extension (TENANT_SCOPED_MODELS) for the
// same reason YellowZoneItem is — a user's inbox is a direct top-level
// list/count query, not a sub-resource reached through a parent — but
// tenant scoping alone is NOT sufficient isolation here: every service
// method additionally filters by userId explicitly, since the extension
// only ever injects organizationId, never userId. See
// notification.service.ts for where that second filter lives.
//
// targetType/targetId are a generic pointer (string, not a real FK) —
// same reasoning as YellowZoneItem.driverId/shipId and
// AssignmentAttempt.provider: written by exactly one call site per
// notification type, from already-validated data, never from user input,
// and a real FK would force every future notification type to point at
// the same target model, which defeats the point of targetType existing
// at all.
model Notification {
  id             String                 @id @default(cuid())
  organizationId String
  userId         String
  type           NotificationType
  title          String
  message        String
  targetType     NotificationTargetType
  targetId       String
  readAt         DateTime?
  createdAt      DateTime               @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The idempotency key (see notification.service.ts's createForRecipients):
  // one notification per (recipient, source event) pair, at the database
  // level, not just application logic — a duplicate webhook/reconciliation
  // delivery that already produced its one YellowZoneItem (idempotent via
  // YellowZoneItem.assignmentAttemptId's own uniqueness) would otherwise
  // still be able to fan out a second round of notifications for the same
  // escalation if the notification step ran twice. targetId (not a
  // separately-generated "source event id") IS the natural deterministic
  // key here — one YellowZoneItem can only ever produce one
  // yellow_zone.escalated notification per recipient, full stop.
  @@unique([userId, targetType, targetId, type])
  // Every list query this table serves is "this user's inbox in this org,
  // newest first" (the default view) — organizationId leads since the
  // tenant-scoping extension always injects it first, userId narrows to
  // one recipient, createdAt orders the result.
  @@index([organizationId, userId, createdAt])
  // The unread-count query (readAt IS NULL) is hit on every page load and
  // every realtime invalidation — frequent enough to justify its own
  // index rather than relying on the createdAt-ordered one above, which
  // doesn't help a query that filters on readAt instead of sorting on it.
  @@index([organizationId, userId, readAt])
  @@map("notifications")
}

enum NotificationType {
  YELLOW_ZONE_ESCALATED
}

enum NotificationTargetType {
  YELLOW_ZONE_ITEM
}

// Personal appearance/notification preferences — deliberately keyed on
// User, not Organization or Membership. These are per-PERSON settings
// ("how does Kinvo look to me"), not per-tenant ones; a user who belongs
// to more than one organization must see the same theme/font/density in
// both, not have one organization's session silently override another's.
// This is the same User-as-single-platform-identity model Phase 1 already
// established for auth (User.email is globally unique; organization
// access is granted via Membership, never conflated with identity) — this
// model just extends that existing boundary to appearance, not a new one.
//
// One row per user (userId unique, not a list) — every field here is a
// single current value, never a history. Structured enum columns, not a
// JSON blob: every setting here is small, closed, and product-critical
// (exactly the "stable, product-critical" case the schema favors typed
// columns for elsewhere — see YellowZoneItem/Notification's own enum
// usage) — a JSON blob would trade compile-time/DB-level validation for
// no real flexibility benefit, since every field is a fixed, curated
// choice, never free text.
model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique

  theme      Theme      @default(SYSTEM)
  accent     Accent     @default(OCEAN)
  fontFamily FontFamily @default(SYSTEM)
  fontSize   FontSize   @default(DEFAULT)
  density    Density    @default(COMFORTABLE)

  reducedMotion Boolean @default(false)

  // The one notification preference that requires real backend
  // enforcement to be honest, not just a frontend visual toggle — see
  // voice.service.ts's YELLOW_ZONE_ESCALATION_RECIPIENT_ROLES filter,
  // which now also excludes a user who has turned this off.
  yellowZoneEscalationNotifications Boolean @default(true)
  // Frontend-only: plays a short synthesized tone on a live
  // notification.created socket event. Off by default — sound is an
  // opt-in, not an ambient default for a shared-desk operational tool.
  notificationSound                 Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// Phase D (Kinvo UI redesign, Campaigns group): a pre-gate reminder call
// request for a ship's already-confirmed drivers ("report 30 minutes
// early") that a dispatcher creates and any manage-capable teammate
// approves before it's considered sent — mirrors YellowZoneItem's
// create/act-on-by-any-manage-role shape (see permissions.ts), not a
// creator-only workflow. Deliberately does NOT duplicate gate/reportingTime
// from Ship — those already live there; this only records the
// campaign-specific facts (who created/approved it, when, and how many
// drivers were confirmed at approval time).
//
// confirmedDriverCountAtApproval is a snapshot, not a derived value like
// TruckRequirement's confirmedCount — "how many drivers were confirmed
// when this reminder was sent" is a historical fact that must not change
// if a driver is later added or withdrawn, unlike a live count. It's null
// until approved by design (there's nothing to snapshot yet).
//
// No actual reminder call is placed by approving this — CALL-E's existing
// call purpose is assignment outreach/confirmation, and building a second,
// reminder-specific voice-call pathway is out of scope here (see the
// Recruitment/Reminders investigation in docs/ARCHITECTURE.md). Approval
// records a real, honest fact — "this was reviewed and confirmed necessary,
// for N confirmed drivers" — not a claim that anyone was called.
model ReminderCampaign {
  id             String                 @id @default(cuid())
  organizationId String
  shipId         String
  status         ReminderCampaignStatus @default(PENDING_APPROVAL)
  notes          String?

  createdByUserId                String
  approvedByUserId               String?
  approvedAt                     DateTime?
  confirmedDriverCountAtApproval Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ship           Ship         @relation(fields: [shipId], references: [id], onDelete: Cascade)
  // createdByUser: required FK, no onDelete override — matches
  // Assignment.createdByUser's exact precedent (defaults to Restrict), not
  // SetNull, since createdByUserId isn't nullable. approvedByUser: SetNull,
  // matching YellowZoneItem.assignedToUser's exact precedent — it IS
  // nullable, so "we no longer know who approved this" is an acceptable
  // state if a user is later removed.
  createdByUser  User         @relation("ReminderCampaignCreatedBy", fields: [createdByUserId], references: [id])
  approvedByUser User?        @relation("ReminderCampaignApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([shipId])
  @@map("reminder_campaigns")
}

enum ReminderCampaignStatus {
  PENDING_APPROVAL
  SENT
  CANCELLED
}

// FontFamily's default is SYSTEM, not one of the three bundled fonts —
// the app has never loaded a custom font (Tailwind's default sans stack
// resolves to the OS system font), so SYSTEM is what every existing user
// is already seeing. Defaulting to INTER or similar would silently change
// the product's look for everyone the moment this migration runs, not a
// deliberate choice a user made.
enum Theme {
  SYSTEM
  LIGHT
  DARK
}

enum Accent {
  OCEAN
  DEEP_BLUE
  ELECTRIC_BLUE
  TEAL
  SLATE
}

enum FontFamily {
  SYSTEM
  INTER
  PLUS_JAKARTA_SANS
  DM_SANS
}

enum FontSize {
  SMALL
  DEFAULT
  LARGE
  EXTRA_LARGE
}

enum Density {
  COMPACT
  COMFORTABLE
  SPACIOUS
}

enum AssignmentStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
  WITHDRAWN
  CANCELLED
  NO_SHOW
  COMPLETED
}

// SYSTEM_ERROR is reserved and unused until Phase 4 — lets CALL-E
// distinguish "the driver was unreachable" from "our own call
// infrastructure failed" without a migration added under pressure later.
enum AttemptOutcome {
  NO_ANSWER
  BUSY
  UNREACHABLE
  WRONG_NUMBER
  REJECTED
  CONFIRMED
  SYSTEM_ERROR
}

enum Role {
  OWNER
  ADMIN
  DISPATCHER
  VIEWER
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// DRAFT -> RECRUITING -> CONFIRMED -> IN_PROGRESS -> COMPLETED, with
// CANCELLED reachable from any pre-COMPLETED state — the state machine is
// enforced in ships.service.ts, not left implicit (see docs/ARCHITECTURE.md
// §3's note on why: "who cancelled and why" bugs come from skipping this).
enum ShipStatus {
  DRAFT
  RECRUITING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Matches the status badges in the actual Kinvo mockup (🟢 Confirmed,
// 🟡 On call, 🔴 Escalated, ⚪ Idle).
enum DriverAvailability {
  IDLE
  ON_CALL
  CONFIRMED
  ESCALATED
}
