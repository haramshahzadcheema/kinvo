NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://kinvo:kinvo@localhost:5432/kinvo
REDIS_URL=redis://localhost:6379

CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# Dev-only value — generate a real random secret per environment for
# staging/production (min 32 chars). Never reuse this literal value outside
# a local machine.
JWT_ACCESS_SECRET=dev-only-access-token-secret-at-least-32-characters-long
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=kinvo_refresh_token

# Required outside the test environment (see src/config/env.ts) — the
# api/worker processes wire a real CallEAdapter using this key everywhere
# except NODE_ENV=test, which uses an in-memory FakeVoiceProvider instead.
CALLE_API_KEY=
# Override only if CALL-E provides a non-default API base URL.
# CALLE_BASE_URL=
VOICE_CALLS_CONCURRENCY=5
VOICE_WEBHOOK_CONCURRENCY=10
VOICE_RECONCILE_STALE_AFTER_MINUTES=30
VOICE_RECONCILE_INTERVAL_MINUTES=5
