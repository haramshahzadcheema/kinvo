{
  "name": "kinvo",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "build:contracts": "pnpm --filter @kinvo/contracts run build",
    "prisma:generate": "pnpm --filter @kinvo/api run prisma:generate",
    "build": "pnpm -r --if-present run build",
    "dev:api": "pnpm --filter @kinvo/api run dev",
    "dev:web": "pnpm --filter @kinvo/web run dev",
    "db:seed:demo": "pnpm --filter @kinvo/api run seed:demo",
    "db:seed:demo:reset": "pnpm --filter @kinvo/api run seed:demo:reset",
    "lint": "pnpm run build:contracts && pnpm run prisma:generate && pnpm -r --if-present run lint",
    "typecheck": "pnpm run build:contracts && pnpm run prisma:generate && pnpm -r --if-present run typecheck",
    "test": "pnpm run build:contracts && pnpm run prisma:generate && pnpm -r --if-present run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
